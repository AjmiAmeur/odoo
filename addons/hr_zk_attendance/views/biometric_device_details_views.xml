<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Biometric device configuration list view-->
    <record id="biometric_device_details_view_list" model="ir.ui.view">
        <field name="name">hr.zk.biometric.device.details.view.list</field>
        <field name="model">hr.zk.biometric.device.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="device_ip"/>
                <field name="port_number"/>
                <field name="device_status_display" widget="badge"/>

            </list>
        </field>
    </record>
    <!--Biometric device configuration form view-->
    <record id="biometric_device_details_view_form" model="ir.ui.view">
        <field name="name">hr.zk.biometric.device.details.view.form</field>
        <field name="model">hr.zk.biometric.device.details</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_daily_attendance_device_filtered)d"
                            string="🕓 Historique des pointages"
                            type="action"
                            class="btn btn-secondary"/>
                    <button name="action_set_timezone" string=" Set Time"
                            type="object" class="oe_highlight" 
                            invisible="1"
                            />
                    <button name="action_download_attendance"
                            string="Importer Pointages (Tous)"
                            type="object" class="oe_highlight"/>
                    <button name="%(zk_attendance_import_wizard_action)d" 
                            type="action" class="oe_highlight" string="Importer Pointages (période)"/>
        
                    <button name="action_clear_device_logs" string="Effacer dans la Pointeuse" 
                            type="object" class="btn btn-danger" invisible ="1"  />
                    <button name="action_clear_odoo_logs" string="Effacer dans Odoo" 
                            type="object" class="btn btn-warning"/>
                    <button name="action_clear_attendance" string="Nettoyage Complet" 
                        type="object" class="btn btn-primary" invisible ="1"/>
                    <button name="action_restart_device" string="Restart"
                            type="object" class="oe_highlight"
                            confirm="Are you sure you want Restart the Biometric
                            Device?" 
                            invisible="1"/>
                    <button name="action_sync_to_hr_attendance"
                            type="object"
                            string="Convertir en Présence"
                            class="oe_highlight" />
                            
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="device_ip"/>
                        <field name="port_number"/>
                        <field name="address_id"/>
                    </group>
                     <group>
                           <field name="device_status_display" widget="badge" readonly="1"/>
                      </group>
                    <button name="action_test_connection"
                            type="object" class="btn btn-secondary">
                        <i class="fa fa-fw o_button_icon fa-television"/>
                        Test Connection
                    </button>
                </sheet>
            </form>
        </field>
    </record>
    <!--	Action for the biometric device-->
    <record id="biometric_device_details_action" model="ir.actions.act_window">
        <field name="name">Biometric Device</field>
        <field name="res_model">hr.zk.biometric.device.details</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
