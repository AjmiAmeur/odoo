<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Daily attendance list view-->
    <record id="daily_attendance_view_list" model="ir.ui.view">
        <field name="name">hr.zk.daily.attendance.view.list</field>
        <field name="model">hr.zk.daily.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" create="false" delete="false">
                <field name="punching_day"/>
                <field name="employee_id"/>
                <field name="punch_type"/>
                <field name="attendance_type"/>
                <field name="punching_time"/>
                <field name="address_id"/>
                <field name="device_id"/> <!-- ✅ Affichage -->

            </list>
        </field>
    </record>
    <!--    Attendance analysis action-->
    <record id="daily_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance Analysis</field>
        <field name="res_model">hr.zk.daily.attendance</field>
        <field name="view_mode">list</field>
        <field name="context">{}</field>
    </record>
    <record id="action_daily_attendance_device_filtered" model="ir.actions.act_window">
        <field name="name">Historique des pointages</field>
        <field name="res_model">hr.zk.daily.attendance</field>
        <field name="view_mode">list,form,pivot,graph"</field>
        <field name="context">{}</field>
        <field name="domain">[('device_id', '=', active_id)]</field>
    </record>   

</odoo>
