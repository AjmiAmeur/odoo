<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="base.module_category_human_resources_detachements">
            <field name="description">Enable the user to see and manage the detachements from Employee application.</field>
            <field name="sequence">10</field>
        </record>

        <record id="hr_detachement.group_hr_detachement_employee_manager" model="res.groups">
            <field name="name">Employee Manager</field>
            <field name="category_id" ref="base.module_category_human_resources_detachements"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="hr_detachement.group_hr_detachement_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="base.module_category_human_resources_detachements"/>
            <field name="implied_ids" eval="[(4, ref('hr_detachement.group_hr_detachement_employee_manager')), (4, ref('hr.group_hr_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('hr_detachement.group_hr_detachement_manager'))]"/>
        </record>

        <record id="ir_rule_hr_detachement_history_multi_company" model="ir.rule">
            <field name="name">HR Detachement History: Multi Company</field>
            <field name="model_id" ref="model_hr_detachement_history"/>
            <field name="domain_force">['|', ('employee_id.company_id', '=', False), ('employee_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="ir_rule_hr_detachement_employee_manager" model="ir.rule">
            <field name="name">HR Detachement: Employee Manager</field>
            <field name="model_id" ref="model_hr_detachement"/>
            <field name="groups" eval="[(4, ref('hr_detachement.group_hr_detachement_employee_manager'))]"/>
            <field name="domain_force">['|', ('employee_id.parent_id.user_id', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        </record>

        <record id="ir_rule_hr_detachement_manager" model="ir.rule">
            <field name="name">HR Detachement: Detachement Manager</field>
            <field name="model_id" ref="model_hr_detachement"/>
            <field name="groups" eval="[(4, ref('hr_detachement.group_hr_detachement_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="ir_rule_hr_detachement_multi_company" model="ir.rule">
            <field name="name">HR Detachement: Multi Company</field>
            <field name="model_id" ref="model_hr_detachement"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        

    </data>
</odoo>
