<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Detachement-related subtypes for messaging / Chatter -->
        <record id="mt_detachement_pending" model="mail.message.subtype">
            <field name="name">To Renew</field>
            <field name="res_model">hr.detachement</field>
            <field name="default" eval="True"/>
            <field name="description">Detachment about to expire</field>
        </record>
        <record id="mt_detachement_close" model="mail.message.subtype">
            <field name="name">Expired</field>
            <field name="res_model">hr.detachement</field>
            <field name="default" eval="False"/>
            <field name="description">Detachment expired</field>
        </record>
        <!-- Department-related (parent) subtypes for messaging / Chatter -->
        <record id="mt_department_detachement_pending" model="mail.message.subtype">
            <field name="name">Detachment to Renew</field>
            <field name="res_model">hr.department</field>
            <field name="default" eval="False"/>
            <field name="parent_id" ref="mt_detachement_pending"/>
            <field name="description">Detachment about to expire</field>
        </record>

        <!-- Expired Soon -->
        <record id="ir_cron_data_detachement_update_state" model="ir.cron">
            <field name="name">HR Detachment: update state</field>
            <field name="model_id" ref="model_hr_detachement"/>
            <field name="state">code</field>
            <field name="code">model.with_context(from_cron=True).update_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
