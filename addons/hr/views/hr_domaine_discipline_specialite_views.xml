<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_domaine_discipline_specialite_form" model="ir.ui.view">
        <field name="name">hr.domaine.discipline.specialite.form</field>
        <field name="model">hr.domaine.discipline.specialite</field>
        <field name="arch" type="xml">
            <form string="specialité académique par domaine">
                <sheet>
                    <group>
                        <field name="domaine_id"/>
                        <field name="discipline_id"/>
                        <field name="code"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
     </record>

     <record id="view_domaine_discipline_specialite_list" model="ir.ui.view">
        <field name="name">hr.domaine.discipline.specialite.list</field>
        <field name="model">hr.domaine.discipline.specialite</field>
        <field name="arch" type="xml">
            <list string="Liste des spécialités académiques par domaine et discipline">
                    <field name="domaine_id"/>
                    <field name="discipline_id"/>
                    <field name="code"/>
                    <field name="name"/>
            </list>
        </field>
     </record>
    <record id="view_domaine_discipline_specialite_search" model="ir.ui.view">
        <field name="name">hr.domaine.discipline.specialite</field>
        <field name="model">hr.domaine.discipline.specialite</field>
        <field name="arch" type="xml">
            <search string="rechercher speciualite">
                <field name="domaine_id"/>
                <field name="discipline_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="name" string="الإختصاص" context="{'lang': 'ar_001'}"/>

                <searchpanel>
                        <field name="domaine_id" icon="fa-object-group" enable_counters="1"/>
                        <field name="discipline_id" icon="fa fa-book" enable_counters="1"/> 
                </searchpanel>
                

                <group expand="0" string="Group By">
                        <filter name="group_domaine" string="Domaine" domain="[]" context="{'group_by': 'domaine_id'}"/>
                        <filter name="group_discipline" string="Discipline" domain="[]" context="{'group_by': 'discipline_id'}"/>
                </group>
            </search>
        </field>
    </record>
     <record id="open_view_domaine_discipline_specialite_form" model="ir.actions.act_window">
        <field name="name">Spécialité</field>
        <field name="res_model">hr.domaine.discipline.specialite</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_domaine_discipline_specialite_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune spécialité trouvée ! Créez-en une
            </p>
            <p>
                Une discipline académique ou un domaine académique est une subdivision des connaissances qui sont enseignées et étudiées au niveau collégial ou universitaire.
            </p>
        </field>
     </record>
 </odoo>