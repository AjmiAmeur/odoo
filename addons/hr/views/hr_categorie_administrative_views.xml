<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_categorie_administrative_form" model="ir.ui.view">
        <field name="name">hr.categorie.administrative.form</field>
        <field name="model">hr.categorie.administrative</field>
        <field name="arch" type="xml">
            <form string="catégories et sous catégories :Administration publique">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
     </record>

     <record id="view_categorie_administrative_list" model="ir.ui.view">
        <field name="name">hr.categorie.administrative.list</field>
        <field name="model">hr.categorie.administrative</field>
        <field name="arch" type="xml">
            <list string="catégories et sous catégories :Administration publique" editable="bottom">
                <field name="name"/>
            </list>
        </field>
     </record>

     <record id="open_view_categorie_administrative_form" model="ir.actions.act_window">
        <field name="name">Catégories</field>
        <field name="res_model">hr.categorie.administrative</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Catégorie found ! Let's create one
            </p>
            <p>
                Use Catégorie to categorize your Employees.
            </p>
        </field>
     </record>
 </odoo>
