<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.disponibilite</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employee_rights_setting_container']" position="after">
                <block title="Mise en disponibilité" id="hr_disponibilite">
                    <setting string="Préavis d’expiration de la mise en disponibilité" id="disponibilite_notice_period"
                        title="Nombre de jours avant la date de fin de la mise en disponibilité pour déclencher un avertissement d’expiration.">
                        <field name="disponibilite_expiration_notice_period" class="w-25"/><span>Days</span>
                    </setting>
                    <setting string="Préavis d’expiration du permis de travail" id="work_permit_notice_period"
                        title="Nombre de jours avant la date d’expiration du permis de travail pour déclencher un avertissement">
                        <field name="work_permit_expiration_notice_period" class="w-25"/><span>Days</span>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
