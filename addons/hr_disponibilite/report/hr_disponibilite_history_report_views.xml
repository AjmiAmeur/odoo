<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_disponibilite_history_view_search" model="ir.ui.view">
        <field name="name">hr.disponibilite.history.search</field>
        <field name="model">hr.disponibilite.history</field>
        <field name="arch" type="xml">
            <search string="Rechercher une référence de mise en disponibilité">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="state"/>
                <field name="is_under_disponibilite"/>
                <filter string="Mises en disponibilité en cours" name="open_disponibilites" domain="[('state', '=', 'open')]"/>
                <filter string="Disponibilités à examiner" name="disponibilite_to_review" domain="['|', ('state', 'in', ['draft', 'close', 'cancel']), ('is_under_disponibilite', '!=', True)]"/>
                <filter string="NAucune mise en disponibilité" name="no_disponibilites" domain="[('disponibilite_id', '=', False)]"/>
                <filter string="Actuellement en mise en disponibilité" name="currently_under_disponibilite" domain="[('is_under_disponibilite', '=', True)]"/>
                <filter string="Active Employees" name="active_employees" domain="[('active_employee', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name='group_by_state' domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="hr_disponibilite_history_view_form_action" model="ir.actions.act_window">
        <field name="name">Disponibilités</field>
        <field name="res_model">hr.disponibilite.history</field>
        <field name="view_mode">form</field>
        <field name="context">{'search_default_active_employees': 1}</field>
    </record>
    <record id="hr_disponibilite_history_view_form" model="ir.ui.view">
        <field name="name">hr.disponibilite.history.form</field>
        <field name="model">hr.disponibilite.history</field>
        <field name="arch" type="xml">
            <form string="Disponibilité History"
                  create="false"
                  edit="false"
                  delete="false"
                  duplicate="false"
                  import="false">
                <header>
                    <button name="hr_disponibilite_view_form_new_action" string="Create" type="object" groups="hr_disponibilite.group_hr_disponibilite_manager" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <h1>
                        <div class="d-flex justify-content-start">
                            <div>
                                <field name="display_name"/>
                            </div>
                            <div class="ps-3">
                                <field name="under_disponibilite_state" widget="state_selection" readonly="1"/>
                            </div>
                        </div>
                    </h1>
                    <h2>
                        <field name="employee_id" widget="many2one_avatar_user"/>
                    </h2>
                    <group>
                        <group>
                            <field name="disponibilite_id" invisible="1"/>
                            <field name="company_country_id" invisible="1"/>
                            <field name="country_code" invisible="1"/>
                            
                        </group>
                        <group>
                           
                        </group>
                    </group>
                    <notebook>
                        <page string="Disponibilité History" name="disponibilite_history">
                            <field name="disponibilite_ids" widget="one2many" readonly="0">
                                <list string="Current Disponibilités"
                                      decoration-primary="state == 'open'"
                                      decoration-muted="state == 'close'"
                                      decoration-bf="id == parent.disponibilite_id"
                                      default_order = "date_start desc, state desc"
                                      editable="bottom"
                                      no_open="1"
                                      create="0" delete="0">
                                    <button name="action_open_disponibilite_form" type="object" icon="fa-external-link" title="Open Disponibilité"/>
                                    <field name="id" column_invisible="True"/>
                                    <field name="name" string="Disponibilité Name"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'close'" decoration-success="state == 'open'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employee Information" name="disponibilite_others">
                            <group>
                                <field name="date_hired"/>
                                <field name="hr_responsible_id" widget="many2one_avatar_user"/>
                                <field name="company_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hr_disponibilite_history_view_list_action" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.disponibilite.history</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_disponibilite_history_view_search"/>
        <field name="context">
            {
                'search_default_active_employees': 1,
                'search_default_group_by_state': 1
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No data to display
            </p>
        </field>
    </record>
    <record id="hr_disponibilite_history_to_review_view_list_action" model="ir.actions.act_window">
        <field name="name">Disponibilités to Review</field>
        <field name="res_model">hr.disponibilite.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_disponibilite_history_view_search"/>
        <field name="context">
            {
                'search_default_to_review': 1,
                'search_default_active_employees': 1
            }
        </field>
    </record>
    <record id="hr_disponibilite_history_view_list" model="ir.ui.view">
        <field name="name">hr.disponibilite.history.list</field>
        <field name="model">hr.disponibilite.history</field>
        <field name="arch" type="xml">
            <list string="Disponibilités"
                  default_order = 'is_under_disponibilite, date_start desc'
                  edit="false"
                  delete="false"
                  duplicate="false"
                  import="false"
                  create="false">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="date_hired"/>
                <field name="is_under_disponibilite" column_invisible="True"/>
                <field name="name"/>
                <field name="date_start"/>
                <field name="under_disponibilite_state" widget="state_selection" optional="hide"
                    options="{'hide_label': False}"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'close'"
                       decoration-success="state == 'open'"/>
                <field name="disponibilite_count"/>
            </list>
        </field>
    </record>
    <record id="hr_disponibilite_history_view_kanban" model="ir.ui.view">
        <field name="name">hr.disponibilite.history.view.kanban</field>
        <field name="model">hr.disponibilite.history</field>
        <field name="arch" type="xml">
            <kanban default_order="date_end" sample="1" create="0">
                <progressbar field="activity_state" colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <field class="fw-bold fs-5" name="display_name"/>
                        <field class="ms-auto" name="employee_id" widget="many2one_avatar_employee"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
